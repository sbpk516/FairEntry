# Copy to .env (which is gitignored) and fill in. Never commit real keys.
# The deterministic core (Phases 0-3, UI) runs WITHOUT any of these.

FINVIZ_API_KEY=
FINNHUB_API_KEY=
DEEPSEEK_API_KEY=          # only needed for the reasoning layer (Phase 4)
SEC_CONTACT_EMAIL=you@example.com   # SEC EDGAR fair-use requires a real contact

# Nasdaq Data Link / Sharadar SFA. Keep local; never commit or paste into chat.
NASDAQ_DATA_LINK_API_KEY=
# Optional future direct Sharadar subscription; not needed for the Nasdaq snapshot.
SHARADAR_API_KEY=

# Optional 200-WMA email alerts (the alert list is always shown in the web app)
WMA_ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
